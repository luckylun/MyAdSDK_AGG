## 4.3 配置激励视频广告

初始化:

```objc
self.rewardVideoAd = [[AdMoreRewardVideo alloc] initWithPlaceId:@"814418694609775"];
    //禁音播放  默认为NO
    self.rewardVideoAd.videoMuted = NO;
    
    self.rewardVideoAd.delegate = self;
    
    self.rewardVideoAd.viewController = self;

    //加载广告
    [self.rewardVideoAd loadAd];
```

回调代理:

```objc
/****************************AdMoreRewardVideoDelegate*****************************/
/**
 广告数据加载成功回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdDidLoad:(AdMoreRewardVideo * _Nullable)rewardedVideoAd{
    self.videoStatus.text = @"广告数据加载成功";
    NSLog(@"激励视频--广告数据加载成功");
}

/**
 视频数据下载成功回调，已经下载过的视频会直接回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdVideoDidLoad:(AdMoreRewardVideo * _Nullable)rewardedVideoAd{
    self.videoStatus.text = @"视频文件加载成功";
    NSLog(@"激励视频--视频文件加载成功");
}

/**
 视频播放页即将展示回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdWillVisible:(AdMoreRewardVideo * _Nullable)rewardedVideoAd{
    self.videoStatus.text = @"视频播放页即将打开";
    NSLog(@"激励视频--视频播放页即将打开");
}

/**
 视频广告曝光回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdDidExposed:(AdMoreRewardVideo *_Nullable)rewardedVideoAd{
    self.videoStatus.text = @"广告已曝光";
    NSLog(@"激励视频--广告已曝光");
}

/**
 视频播放页关闭回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdDidClose:(AdMoreRewardVideo *_Nullable)rewardedVideoAd{
    self.videoStatus.text = @"广告已关闭";
//    广告关闭后释放ad对象
    self.rewardVideoAd.delegate = nil;
    self.rewardVideoAd = nil;
    NSLog(@"激励视频--广告已关闭");
}

/**
 视频广告信息点击回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdDidClicked:(AdMoreRewardVideo *_Nullable)rewardedVideoAd{
    self.videoStatus.text = @"广告已点击";
    NSLog(@"激励视频--广告已点击");
}

/**
 视频广告各种错误信息回调
 @param rewardedVideoAd AdMoreRewardVideo 实例
 @param error 具体错误信息
 */
- (void)am_rewardVideoAd:(AdMoreRewardVideo *_Nullable)rewardedVideoAd didFailWithError:(NSError *_Nullable)error{
    NSLog(@"激励视频--ERROR:%@",error);
}

/**
 视频广告播放达到激励条件回调

 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdDidRewardEffective:(AdMoreRewardVideo *_Nullable)rewardedVideoAd{
    self.videoStatus.text = @"播放达到激励条件";
    NSLog(@"激励视频--播放达到激励条件");
}

/**
 视频广告视频播放完成
 @param rewardedVideoAd AdMoreRewardVideo 实例
 */
- (void)am_rewardVideoAdDidPlayFinish:(AdMoreRewardVideo *_Nullable)rewardedVideoAd{
    self.videoStatus.text = @"视频播放结束";
    NSLog(@"激励视频--视频播放结束");
}
 ```

## 4.4 配置Banner广告

初始化:

```objc
self.bannerView = [AdMoreBanner initWithFrame:CGRectMake(0, 150, self.view.width, 200) placementId:@"189578206581063" viewController:self];
self.bannerView.backgroundColor = UIColor.redColor;
self.bannerView.delegate = self;
[self.bannerView loadAd];
[self.view addSubview:self.bannerView];
```

回调代理:

```objc
/****************************AdMoreBannerDelegate*****************************/
// 广告加载成功
/// @param bannerView bannerView
- (void)am_adBannerViewDidLoad:(AdMoreBanner *)bannerView
{
    NSLog(@"-----广告加载成功 , %s", __func__);
}

/// 广告加载失败
/// @param bannerView bannerView
/// @param error 失败信息
- (void)am_adBannerViewFailedToLoad:(AdMoreBanner *)bannerView error:(NSError *)error
{
    NSLog(@"-----%@", error);
    NSLog(@"-----广告加载失败 , %s", __func__);
}

/// 广告曝光
/// @param bannerView bannerView
- (void)am_adBannerViewWillExpose:(AdMoreBanner *)bannerView
{
    NSLog(@"-----广告曝光 , %s", __func__);
}

/// 广告被点击
/// @param bannerView bannerView
- (void)am_adBannerViewClicked:(AdMoreBanner *)bannerView
{
    NSLog(@"-----广告被点击 , %s", __func__);
}

/// 广告被用户主动关闭
/// @param bannerView bannerView
- (void)am_adBannerViewWillClose:(AdMoreBanner *)bannerView
{
    NSLog(@"-----广告被用户主动关闭 , %s", __func__);
    [self.bannerView removeFromSuperview];
    self.bannerView = nil;
}
```


## 4.5 配置插屏广告

初始化:

```objc
_interstitialAd = [[AMInterstitialAdLoader alloc] initWithPlaceId:@"test_i_cp3"];
    _interstitialAd.delegate = self;
    _interstitialAd.videoMuted = NO;
    _interstitialAd.videoAutoPlayOnWWAN = YES;
    _interstitialAd.viewController = self;
    [_interstitialAd loadAd];
```

回调代理:

```objc
/****************************AMInterstitialAdLoaderDelegate*****************************/
/**
 *  插屏2.0广告预加载成功回调
 *  当接收服务器返回的广告数据成功且预加载后调用该函数
 */
- (void)am_interstitialSuccessToLoadAd:(AMInterstitialAdLoader *)interstitialAd
{
    [_interstitialAd presentAdFromRootViewController:self.navigationController];
    [self.statusBtn setTitle:@"广告加载成功" forState:(UIControlStateNormal)];
    
}

/**
 *  插屏2.0广告预加载失败回调
 *  当接收服务器返回的广告数据失败后调用该函数
 */
- (void)am_interstitialFailToLoadAd:(AMInterstitialAdLoader *)interstitialAd error:(NSError *)error
{
    NSLog(@"am_interstitialFailToLoadAd -- %@",error.localizedDescription);
    [self.statusBtn setTitle:@"广告加载失败" forState:(UIControlStateNormal)];
    
}

/**
 *  插屏2.0广告将要展示回调
